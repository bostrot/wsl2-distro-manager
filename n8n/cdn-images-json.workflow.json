        "jsCode": "// Upstream answered (or did not). Decide what to serve.\n//\n// The HTTP node runs with onError: continueRegularOutput, so a GitHub outage\n// arrives here as an item carrying `error` rather than aborting the run. That\n// is the whole point: on 2026-09-09 this endpoint answered 200 with an empty\n// body, and the app quietly fell back to the copy bundled at build time. A\n// stale-but-real catalogue beats an empty one, so the last good copy is\n// served and only a cold cache with a dead upstream is an error.\nconst store = $getWorkflowStaticData('global');\nconst item = $input.first().json;\nconst failed = item.error !== undefined || item.$$error !== undefined;\n\nlet fetched = null;\nif (!failed) {\n  // The HTTP node parses JSON automatically; a string body means it did not.\n  const raw = item.data !== undefined ? item.data : item;\n  const parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\n  if (parsed && typeof parsed === 'object' && Object.keys(parsed).length > 0) {\n    fetched = parsed;\n  }\n}\n\nif (fetched) {\n  store.body = JSON.stringify(fetched);\n  store.fetchedAt = Date.now();\n  return [{ json: { body: fetched, cache: 'miss' } }];\n}\n\nif (store.body) {\n  return [{ json: { body: JSON.parse(store.body), cache: 'stale' } }];\n}\n\nthrow new Error('images.json is unavailable upstream and nothing is cached yet');\n"
